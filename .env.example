# ============================================================
# VOX, Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no repositório
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- IA (OpenAI), opcional por usuário ---
OPENAI_API_KEY=sk-...

# --- Bíblia (abibliadigital.com.br) ---
# Crie um usuário em https://www.abibliadigital.com.br e pegue seu JWT
BIBLE_API_TOKEN=seu-jwt-token
BIBLE_API_URL=https://www.abibliadigital.com.br/api

# --- PWA ---
NEXT_PUBLIC_PWA_ENABLED=true
